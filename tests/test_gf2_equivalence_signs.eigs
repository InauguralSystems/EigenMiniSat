load_file of "lib/int_vector.eigs"
load_file of "lib/dimacs.eigs"
load_file of "lib/xor.eigs"

# hq#58 EMS-GF2-1: every clause gf2_reduce_xors derives must be IMPLIED by the
# XOR system it came from. test_gf2_elimination.eigs only counts equivalences,
# and its torus systems derive none, so a flipped sign in the equivalence
# clauses (x = y emitted as x = not y) passed every gate while --gf2 answered
# UNSAT on a SAT instance. Checked here by brute force: enumerate every
# assignment of each small system's variables, and on each one that satisfies
# all its XORs, every derived clause must be true.

define check(label, condition) as:
    if not condition:
        print of f"FAIL: {label}"
        assert of [0, label]
    print of f"PASS: {label}"
    return 1

define value_of(assign, lit) as:
    v is lit
    if v < 0:
        v is 0 - v
    val is assign[v]
    if lit < 0:
        return 1 - val
    return val

define xors_hold(xors, assign) as:
    for equation in xors:
        total is 0
        for v in equation.vars:
            total += assign[v]
        if (total % 2) != (equation.rhs % 2):
            return 0
    return 1

define clause_holds(clause, assign) as:
    for lit in clause:
        if (value_of of [assign, lit]) != 0:
            return 1
    return 0

# Count the two equivalence shapes: [-a, b] / [a, -b] is "equal" and
# [a, b] / [-a, -b] is "opposite". Units are length 1.
define equivalence_shapes(derived) as:
    equal is 0
    opposite is 0
    for clause in derived:
        if (len of clause) == 2:
            if (clause[0] < 0) == (clause[1] < 0):
                opposite += 1
            else:
                equal += 1
    return {"equal": equal, "opposite": opposite}

define check_system(label, nvars, xors) as:
    reduced is gf2_reduce_xors of xors
    check of [f"{label}: system is consistent", reduced.inconsistent == 0]
    shapes is equivalence_shapes of reduced.derived_clauses
    assign is []
    for unused in range of (nvars + 1):
        append of [assign, 0]
    solutions is 0
    violations is 0
    done is 0
    loop while done == 0:
        if (xors_hold of [xors, assign]) != 0:
            solutions += 1
            for clause in reduced.derived_clauses:
                if (clause_holds of [clause, assign]) == 0:
                    violations += 1
        # Binary increment over assign[1..nvars]; overflow ends the sweep.
        i is 1
        carry is 1
        loop while carry != 0 and i <= nvars:
            if assign[i] == 0:
                assign[i] is 1
                carry is 0
            else:
                assign[i] is 0
                i += 1
        if carry != 0:
            done is 1
    print of f"REPORT: {label} derived={len of reduced.derived_clauses} units={reduced.units} equivalences={reduced.equivalences} equal_sign_clauses={shapes.equal} opposite_sign_clauses={shapes.opposite} solutions={solutions} violations={violations}"
    check of [f"{label}: has solutions to check against", solutions > 0]
    check of [f"{label}: every derived clause holds on every XOR solution", violations == 0]
    return shapes

print of "=== GF(2) derived-clause sign tests ==="

# x1 ^ x2 = 0, x2 ^ x3 = 1: x1 = x2 (equal) and both are not x3 (opposite).
mixed is check_system of ["chain 0/1", 3, [{"vars": [1, 2], "rhs": 0}, {"vars": [2, 3], "rhs": 1}]]
check of ["chain 0/1: derives an equal-sign equivalence", mixed.equal > 0]
check of ["chain 0/1: derives an opposite-sign equivalence", mixed.opposite > 0]

# Only odd links: x1 = not x2 = x3.
odd is check_system of ["chain 1/1", 3, [{"vars": [1, 2], "rhs": 1}, {"vars": [2, 3], "rhs": 1}]]
check of ["chain 1/1: derives both signs", odd.equal > 0 and odd.opposite > 0]

# The corpus ladder (tests/corpus/xor_ladder_sat.cnf): x_i ^ x_(i+1) = 1 for
# i = 1..5 -- the instance --gf2 refuted under the planted sign flip. Read
# through the real parser and detector, so the test follows the file.
ladder_cnf is parse_dimacs_file of "tests/corpus/xor_ladder_sat.cnf"
ladder_census is detect_xors of ladder_cnf.clauses
check of ["xor_ladder_sat: detector finds its 5 XORs", ladder_census.xor_count == 5]
ladder is check_system of ["xor_ladder_sat", ladder_cnf.nvars, ladder_census.xors]
check of ["xor_ladder_sat: derives both signs", ladder.equal > 0 and ladder.opposite > 0]

# Wider rows and a unit: x1^x2^x3 = 1, x2^x3 = 0 (so x1 = 1), x3^x4^x5 = 0.
check_system of ["wide + unit", 5, [{"vars": [1, 2, 3], "rhs": 1}, {"vars": [2, 3], "rhs": 0}, {"vars": [3, 4, 5], "rhs": 0}]]
