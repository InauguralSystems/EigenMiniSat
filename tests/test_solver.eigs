assert_eq of ["pigeonhole cdcl learnt allocs", php_cdcl.learnt_allocs, php_cdcl.learnts]
assert_true of ["pigeonhole cdcl store copies", php_cdcl.store_clause_copies > 0]
assert_true of ["pigeonhole cdcl store copy lits", php_cdcl.store_clause_copy_lits > 0]
assert_eq of ["pigeonhole cdcl analysis rebuilds removed", php_cdcl.analysis_rebuilds, 0]
assert_eq of ["pigeonhole cdcl analysis rebuild lits removed", php_cdcl.analysis_rebuild_lits, 0]
assert_true of ["pigeonhole cdcl native analysis scans", php_cdcl.analysis_store_scans > 0]
assert_true of ["pigeonhole cdcl native analysis lits", php_cdcl.analysis_store_lits > 0]
assert_true of ["pigeonhole cdcl native learnts", php_cdcl.analysis_native_learnts > 0]
assert_true of ["pigeonhole cdcl clause bumps", php_cdcl.clause_activity_bumps > 0]
print of "  pigeonhole UNSAT: ok"

# CDCL clause-store compaction coverage. The default deferred policy keeps
# compact_runs at 0 on fixtures this small, so the physical-compaction path
# (clause-store copy + watch rebuild + trail replay) went unexercised by the
# correctness suite. Force it with the eager policy on small, fast instances
# and assert the verdict and a valid model still hold after compaction runs.
compact_php is pigeonhole_case of [5, 4]
compact_unsat is solve_cnf_cdcl_with_options of [compact_php.nvars, compact_php.clauses, {"compact_policy": "eager"}]
assert_eq of ["compaction unsat verdict", compact_unsat.status, "UNSAT"]
assert_true of ["compaction runs fire", compact_unsat.compact_runs > 0]
assert_true of ["compaction removes clauses", compact_unsat.compact_removed > 0]
assert_true of ["compaction rebuilds watches", compact_unsat.watch_rebuilds > 0]
assert_true of ["compaction replays trail", compact_unsat.compact_replays > 0]

compact_sat_case is gen_random_3sat of [45, 189, 7]
compact_sat is solve_cnf_cdcl_with_options of [compact_sat_case.nvars, compact_sat_case.clauses, {"compact_policy": "eager"}]
assert_eq of ["compaction sat verdict", compact_sat.status, "SAT"]
assert_true of ["compaction sat runs fire", compact_sat.compact_runs > 0]
assert_true of ["compaction sat model valid", model_satisfies of [compact_sat_case.nvars, compact_sat_case.clauses, compact_sat.model]]
print of "  CDCL clause-store compaction: ok"

php4 is pigeonhole_case of [4, 3]
php4_cdcl is solve_cnf_cdcl of [php4.nvars, php4.clauses]
assert_eq of ["pigeonhole 4-3 cdcl UNSAT", php4_cdcl.status, "UNSAT"]
assert_eq of ["pigeonhole 4-3 default restart policy", php4_cdcl.restart_policy, "geometric"]
assert_true of ["pigeonhole 4-3 restarts", php4_cdcl.restarts > 0]
assert_eq of ["pigeonhole 4-3 restart index", php4_cdcl.restart_index, php4_cdcl.restarts]
assert_true of ["pigeonhole 4-3 restart cancels", php4_cdcl.restart_cancels > 0]
assert_true of ["pigeonhole 4-3 phase saves", php4_cdcl.phase_saves > 0]
assert_eq of ["pigeonhole 4-3 deferred compacts", php4_cdcl.compact_runs, 0]
assert_true of ["pigeonhole 4-3 deferred or glue", php4_cdcl.compact_deferred >= 0]
assert_eq of ["pigeonhole 4-3 no watch rebuilds", php4_cdcl.watch_rebuilds, 0]
assert_eq of ["pigeonhole 4-3 no trail replays", php4_cdcl.compact_replays, 0]
assert_eq of ["pigeonhole 4-3 lazy detaches", php4_cdcl.watch_detaches, 0]
assert_true of ["pigeonhole 4-3 skips or glue", php4_cdcl.deleted_watch_skips >= 0]
assert_eq of ["pigeonhole 4-3 no watch prunes", php4_cdcl.watch_prunes, 0]
assert_true of ["pigeonhole 4-3 minimize checks", php4_cdcl.minimize_checks > 0]
assert_true of ["pigeonhole 4-3 minimize removed", php4_cdcl.minimize_removed >= 0]
php4_luby is solve_cnf_cdcl_with_options of [php4.nvars, php4.clauses, {"restart_policy": "luby", "restart_first": 1}]
assert_eq of ["pigeonhole 4-3 luby UNSAT", php4_luby.status, "UNSAT"]
assert_eq of ["pigeonhole 4-3 luby policy", php4_luby.restart_policy, "luby"]
assert_true of ["pigeonhole 4-3 luby restarts", php4_luby.restarts > 0]
assert_eq of ["pigeonhole 4-3 luby restart index", php4_luby.restart_index, php4_luby.restarts]
print of "  restart policies: ok"

# #84: variable-activity rescaling. `var_inc` grows as 1 / var_decay^conflicts
# and, unrescaled, hits the double ceiling on conflict 13,828 — 1e308 + 1e308
# == 1e308, so further bumps are no-ops, activities tie, and `order_better`
# falls through to `a < b`: branching becomes static lowest-index-first while
# the heap keeps running. Rescaling is a pure REPARAMETERISATION: dividing
# every activity and the increment by the same constant preserves every
# comparison, so the search must be bit-identical no matter where the limit
# sits. That invariant is the gate here — it is what makes the rescale safe,
# and it is cheap. The evidence that the collapse itself is gone needs ~16k
# conflicts and is banked in BASELINE.md, not run per-suite.
rescale_ref is solve_cnf_cdcl_with_options of [php4.nvars, php4.clauses, {"var_rescale_limit": 0}]
assert_eq of ["rescale baseline UNSAT", rescale_ref.status, "UNSAT"]
assert_eq of ["rescale baseline does not rescale", rescale_ref.var_rescales, 0]
for rescale_limit in [0.001, 1]:
    rescale_run is solve_cnf_cdcl_with_options of [php4.nvars, php4.clauses, {"var_rescale_limit": rescale_limit}]
    assert_eq of [f"rescale limit {rescale_limit} same status", rescale_run.status, rescale_ref.status]
    assert_eq of [f"rescale limit {rescale_limit} same decisions", rescale_run.decisions, rescale_ref.decisions]
    assert_eq of [f"rescale limit {rescale_limit} same conflicts", rescale_run.conflicts, rescale_ref.conflicts]
    assert_eq of [f"rescale limit {rescale_limit} same resolutions", rescale_run.resolutions, rescale_ref.resolutions]
    assert_true of [f"rescale limit {rescale_limit} fired", rescale_run.var_rescales > 0]
# A limit above the instance's activity range simply never fires, and the run
# is identical again — the check is scale-free, not tuned to a magic number.
rescale_high is solve_cnf_cdcl_with_options of [php4.nvars, php4.clauses, {"var_rescale_limit": 1000}]
assert_eq of ["rescale limit above range never fires", rescale_high.var_rescales, 0]
assert_eq of ["rescale limit above range same conflicts", rescale_high.conflicts, rescale_ref.conflicts]
# The default limit is high enough that a small instance never reaches it, so
# the fix is inert below threshold — every counter banked before #84 on an
# instance that stays under 1e100 is unchanged by it.
rescale_default is solve_cnf_cdcl of [php4.nvars, php4.clauses]
assert_eq of ["default limit inert on small instances", rescale_default.var_rescales, 0]
assert_eq of ["default limit same conflicts", rescale_default.conflicts, rescale_ref.conflicts]
print of "  variable-activity rescaling: ok"

# #85: deletion order. The old key packed both terms into one scalar,
# `(0 - lbd) * 1000000 + activity`, so LBD is the major term only while
# activity stays under 1e6 — and `clause_inc = 1 / 0.999^conflicts` crosses
# 1e6 at about 13,805 conflicts. Past that the sort is effectively
# activity-only. Below it the two keys agree, which is why no instance small
# enough for a suite can tell them apart: the ordering itself is the unit
# under test, driven directly at activities the packed key cannot survive.
# ci 1 is a high-LBD clause with high activity; ci 2 is a glue-ish low-LBD
# clause with none. Deletion takes from the front.
sortkey_state is {
    "clause_lbd":      [0, 5, 3],
    "clause_activity": [0, 1e7, 0],
    "clause_sort_key": "lbd_major"
}
sortkey_major is sort_reduce_candidates of [[1, 2], sortkey_state]
assert_eq of ["lbd_major deletes the high-LBD clause first", sortkey_major[0], 1]
assert_eq of ["lbd_major keeps the glue clause", sortkey_major[1], 2]
sortkey_state.clause_sort_key is "packed"
sortkey_packed is sort_reduce_candidates of [[1, 2], sortkey_state]
assert_eq of ["packed key inverts once activity passes 1e6", sortkey_packed[0], 2]

# Within one LBD level the tie-break is activity, lowest deleted first — the
# two-pass sort must not lose that, which is what makes the stable second pass
# load-bearing rather than incidental.
tie_state is {
    "clause_lbd":      [0, 4, 4, 4],
    "clause_activity": [0, 9e9, 1e9, 5e9],
    "clause_sort_key": "lbd_major"
}
tie_sorted is sort_reduce_candidates of [[1, 2, 3], tie_state]
assert_eq of ["tie-break lowest activity first", tie_sorted[0], 2]
assert_eq of ["tie-break middle activity second", tie_sorted[1], 3]
assert_eq of ["tie-break highest activity last", tie_sorted[2], 1]

# Clause-activity rescaling is the same reparameterisation argument as #84 —
# under the pair sort it preserves every comparison, so the run is identical
# wherever the limit sits. (It is NOT order-preserving under the packed key:
# scaling activity changes its weight against the fixed 1e6 term, which is one
# reason the two fixes belong together.)
clause_ref is solve_cnf_cdcl_with_options of [php4.nvars, php4.clauses, {"clause_rescale_limit": 0}]
assert_eq of ["clause rescale baseline UNSAT", clause_ref.status, "UNSAT"]
assert_eq of ["clause rescale baseline does not rescale", clause_ref.clause_rescales, 0]
for clause_limit in [0.001, 1]:
    clause_run is solve_cnf_cdcl_with_options of [php4.nvars, php4.clauses, {"clause_rescale_limit": clause_limit}]
    assert_eq of [f"clause limit {clause_limit} same status", clause_run.status, clause_ref.status]
    assert_eq of [f"clause limit {clause_limit} same conflicts", clause_run.conflicts, clause_ref.conflicts]
    assert_eq of [f"clause limit {clause_limit} same resolutions", clause_run.resolutions, clause_ref.resolutions]
    assert_eq of [f"clause limit {clause_limit} same deletions", clause_run.learnt_deleted, clause_ref.learnt_deleted]
    assert_true of [f"clause limit {clause_limit} fired", clause_run.clause_rescales > 0]

# Below the crossover the two keys agree exactly, so nothing banked under
# ~13.8k conflicts moves.
sortkey_packed_run is solve_cnf_cdcl_with_options of [php4.nvars, php4.clauses, {"clause_sort_key": "packed"}]
assert_eq of ["keys agree below the crossover", sortkey_packed_run.conflicts, clause_ref.conflicts]
assert_eq of ["keys agree on deletions below the crossover", sortkey_packed_run.learnt_deleted, clause_ref.learnt_deleted]

# The deletion ORDER only decides anything when a reduce run has more
# candidates than it intends to delete. `reduce_order_bound` counts the runs
# where that holds, so a key change that comes back byte-identical on some
# instance can be explained rather than shrugged at — on Tseitin 4x4 under the
# pre-#86 DB schedule only 40 of 451 reduce runs were order-bound, and on
# pigeonhole 4-3 there are no candidates at all (every learnt clause is glue),
# so the sort never runs. That is why an A/B on a small instance proves
# nothing about the key and the ordering is unit-tested directly above.
assert_eq of ["no candidates means no order-bound runs", clause_ref.reduce_candidates, 0]
assert_eq of ["and nothing to delete", clause_ref.learnt_deleted, 0]
order_bound_case is parse_dimacs_file of "tests/fixtures/pigeonhole_6_5.cnf"
order_bound_run is solve_cnf_cdcl of [order_bound_case.nvars, order_bound_case.clauses]
assert_true of ["candidates counted where reduction has choices",
                order_bound_run.reduce_candidates > 0]
assert_true of ["order-bound runs never exceed reduce runs",
                order_bound_run.reduce_order_bound <= order_bound_run.reduce_runs]
assert_true of ["deletions never exceed candidates",
                order_bound_run.learnt_deleted <= order_bound_run.reduce_candidates]
print of "  LBD-major deletion order: ok"

