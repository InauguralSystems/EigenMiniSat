    corpus_parsed is parse_dimacs_file of corpus.path
    corpus_scan_parsed is parse_dimacs_file_scan of corpus.path
    corpus_token_parsed is parse_dimacs_file_tokens of corpus.path
    corpus_ints_parsed is parse_dimacs_file_ints of corpus.path
    assert_dimacs_same of [f"corpus scan parser {corpus.name}", corpus_parsed, corpus_scan_parsed]
    assert_dimacs_same of [f"corpus token parser {corpus.name}", corpus_parsed, corpus_token_parsed]
    assert_dimacs_same of [f"corpus ints parser {corpus.name}", corpus_parsed, corpus_ints_parsed]
    assert_eq of [f"corpus vars {corpus.name}", corpus_parsed.nvars, corpus.nvars]
    assert_eq of [f"corpus clauses {corpus.name}", len of corpus_parsed.clauses, corpus.nclauses]
    assert_eq of [f"corpus declared vars {corpus.name}", corpus_parsed.declared_vars, corpus.nvars]
    assert_eq of [f"corpus declared clauses {corpus.name}", corpus_parsed.declared_clauses, corpus.nclauses]
    assert_eq of [f"corpus diagnostics {corpus.name}", corpus_parsed.ok, 1]
    corpus_cdcl is solve_cnf_cdcl of [corpus_parsed.nvars, corpus_parsed.clauses]
    assert_eq of [f"corpus status {corpus.name}", corpus_cdcl.status, corpus.expected]
    if corpus_cdcl.status == "SAT":
        assert_true of [f"corpus model {corpus.name}", model_satisfies of [corpus_parsed.nvars, corpus_parsed.clauses, corpus_cdcl.model]]
print of "  external DIMACS corpus: ok"

chain_sat is chain_case of [12, 0]
chain_sat_result is solve_cnf of [chain_sat.nvars, chain_sat.clauses]
assert_eq of ["chain SAT", chain_sat_result.status, "SAT"]
assert_true of ["chain SAT propagates", chain_sat_result.propagations >= 12]
chain_sat_watched is solve_cnf_watched of [chain_sat.nvars, chain_sat.clauses]
assert_eq of ["chain watched SAT", chain_sat_watched.status, "SAT"]
assert_true of ["chain watched propagates", chain_sat_watched.propagations >= 12]
chain_sat_persistent is solve_cnf_persistent of [chain_sat.nvars, chain_sat.clauses]
assert_eq of ["chain persistent SAT", chain_sat_persistent.status, "SAT"]
assert_true of ["chain persistent propagates", chain_sat_persistent.propagations >= 12]
chain_sat_cdcl is solve_cnf_cdcl of [chain_sat.nvars, chain_sat.clauses]
assert_eq of ["chain cdcl SAT", chain_sat_cdcl.status, "SAT"]
assert_true of ["chain cdcl propagates", chain_sat_cdcl.propagations >= 12]
print of "  generated chain SAT: ok"

chain_unsat is chain_case of [12, 1]
chain_unsat_result is solve_cnf of [chain_unsat.nvars, chain_unsat.clauses]
assert_eq of ["chain UNSAT", chain_unsat_result.status, "UNSAT"]
assert_true of ["chain UNSAT conflict", chain_unsat_result.conflicts > 0]
chain_unsat_watched is solve_cnf_watched of [chain_unsat.nvars, chain_unsat.clauses]
assert_eq of ["chain watched UNSAT", chain_unsat_watched.status, "UNSAT"]
assert_true of ["chain watched UNSAT conflict", chain_unsat_watched.conflicts > 0]
chain_unsat_persistent is solve_cnf_persistent of [chain_unsat.nvars, chain_unsat.clauses]
assert_eq of ["chain persistent UNSAT", chain_unsat_persistent.status, "UNSAT"]
assert_true of ["chain persistent UNSAT conflict", chain_unsat_persistent.conflicts > 0]
chain_unsat_cdcl is solve_cnf_cdcl of [chain_unsat.nvars, chain_unsat.clauses]
assert_eq of ["chain cdcl UNSAT", chain_unsat_cdcl.status, "UNSAT"]
assert_true of ["chain cdcl UNSAT conflict", chain_unsat_cdcl.conflicts > 0]
print of "  generated chain UNSAT: ok"

# random 3-SAT
rand_sat is gen_random_3sat of [30, 128, 42]
rand_sat_result is solve_cnf_cdcl of [rand_sat.nvars, rand_sat.clauses]
assert_eq of ["random 3sat-30 SAT", rand_sat_result.status, "SAT"]
assert of [model_satisfies of [rand_sat.nvars, rand_sat.clauses, rand_sat_result.model], "random 3sat-30 model"]
rand_unsat is gen_random_3sat of [30, 128, 100]
rand_unsat_result is solve_cnf_cdcl of [rand_unsat.nvars, rand_unsat.clauses]
assert_eq of ["random 3sat-30 seed100 result", rand_unsat_result.status == "SAT" or rand_unsat_result.status == "UNSAT", 1]
if rand_unsat_result.status == "SAT":
    assert of [model_satisfies of [rand_unsat.nvars, rand_unsat.clauses, rand_unsat_result.model], "random 3sat-30 seed100 model"]
assert_true of ["random 3sat minimize ran", rand_sat_result.minimize_checks >= 0]
print of "  random 3-SAT: ok"

# Budgeted CDCL sessions (cdcl_begin/cdcl_step): a bounded slice per call,
# resumable, with the run-to-completion wrapper re-derived on top. The
# session must reach the same status and the same deterministic counters
# as the one-shot solve, and a finished session must be idempotent.
budget_case is pigeonhole_case of [5, 4]
budget_oneshot is solve_cnf_cdcl of [budget_case.nvars, budget_case.clauses]
assert_eq of ["budgeted oneshot UNSAT", budget_oneshot.status, "UNSAT"]
budget_session is cdcl_begin of [budget_case.nvars, budget_case.clauses, null]
budget_steps is 0
budget_running_seen is 0
loop while budget_session.status == "RUNNING":
    budget_status is cdcl_step of [budget_session, 1]
    budget_steps += 1
    if budget_status == "RUNNING":
        budget_running_seen is 1
assert_eq of ["budgeted session UNSAT", budget_session.status, "UNSAT"]
assert_true of ["budgeted session multiple steps", budget_steps > 1]
assert_true of ["budgeted session saw RUNNING", budget_running_seen == 1]
assert_eq of ["budgeted conflicts match oneshot", budget_session.stats.conflicts, budget_oneshot.conflicts]
assert_eq of ["budgeted decisions match oneshot", budget_session.stats.decisions, budget_oneshot.decisions]
assert_eq of ["budgeted learnts match oneshot", budget_session.stats.learnts, budget_oneshot.learnts]
budget_conflicts_final is budget_session.stats.conflicts
assert_eq of ["finished session idempotent status", cdcl_step of [budget_session, 8], "UNSAT"]
assert_eq of ["finished session idempotent stats", budget_session.stats.conflicts, budget_conflicts_final]
budget_sat_case is parse_dimacs_file of "tests/fixtures/simple_sat.cnf"
budget_sat_session is cdcl_begin of [budget_sat_case.nvars, budget_sat_case.clauses, null]
loop while budget_sat_session.status == "RUNNING":
    cdcl_step of [budget_sat_session, 2]
assert_eq of ["budgeted SAT session", budget_sat_session.status, "SAT"]
assert_true of ["budgeted SAT model satisfies", model_satisfies of [budget_sat_case.nvars, budget_sat_case.clauses, budget_sat_session.model]]
print of "  budgeted CDCL sessions: ok"

# --- Tseitin torus generator ---------------------------------------------
# Structure is asserted here (cheap); the expensive part -- that the odd-charge
# case is genuinely UNSAT and its refutation verifies -- is covered by
# tests/run_proof_check.sh against drat-trim, which keeps this suite fast.
tseitin_odd is tseitin_torus_case of [3, 4, 1]
assert_eq of ["tseitin odd expected UNSAT", tseitin_odd.expected, "UNSAT"]
assert_eq of ["tseitin var count is one per torus edge", tseitin_odd.nvars, 24]
assert_eq of ["tseitin clause count is 2^(deg-1) per vertex", len of tseitin_odd.clauses, 96]
for tseitin_clause in tseitin_odd.clauses:
    assert_eq of ["tseitin clause width is the vertex degree", len of tseitin_clause, 4]

# Same graph, same clause count, charge parity flipped: this one is satisfiable.
# The pair is the control that isolates parity as the source of hardness.
tseitin_even is tseitin_torus_case of [3, 4, 0]
assert_eq of ["tseitin even expected SAT", tseitin_even.expected, "SAT"]
assert_eq of ["tseitin even same var count", tseitin_even.nvars, tseitin_odd.nvars]
assert_eq of ["tseitin even same clause count", len of tseitin_even.clauses, len of tseitin_odd.clauses]
tseitin_even_result is solve_cnf_cdcl of [tseitin_even.nvars, tseitin_even.clauses]
assert_eq of ["tseitin even solves SAT", tseitin_even_result.status, "SAT"]
assert_true of ["tseitin even model satisfies", model_satisfies of [tseitin_even.nvars, tseitin_even.clauses, tseitin_even_result.model]]

# Degenerate sides are clamped to 3 so a vertex's four incident edges stay distinct.
tseitin_clamped is tseitin_torus_case of [1, 2, 1]
assert_eq of ["tseitin clamps rows/cols to 3", tseitin_clamped.nvars, 18]
print of "  tseitin torus generator: ok"

# --- Proof-shape counters -------------------------------------------------
# Asserted on a cheap pigeonhole case, not the Tseitin one -- these solve the
# instance and this suite is the fast gate.
# peak_learnts is the high-water mark, not the end-of-solve count, so it must
# be at least the surviving active_learnts. max_level must be positive on any
# instance that took a decision.
proof_php is pigeonhole_case of [6, 5]
proof_shape is solve_cnf_cdcl of [proof_php.nvars, proof_php.clauses]
assert_eq of ["proof-shape case is UNSAT", proof_shape.status, "UNSAT"]
assert_true of ["peak_learnts >= surviving active_learnts", proof_shape.peak_learnts >= proof_shape.active_learnts]
assert_true of ["peak_learnts <= total learnts", proof_shape.peak_learnts <= proof_shape.learnts]
assert_true of ["max_level positive when decisions were made", proof_shape.max_level > 0]
assert_true of ["max_level bounded by variable count", proof_shape.max_level <= proof_php.nvars]
print of "  proof-shape counters: ok"

# --- DRAT recording -------------------------------------------------------
# Off by default (null options) and on when asked. Line count must be one per
# learnt clause plus the final empty clause (text_builder_append_line leaves a
# trailing newline, so the split yields one extra empty element).
assert_eq of ["proof recording off by default", proof_shape.proof, null]
proof_on is solve_cnf_cdcl_with_options of [proof_php.nvars, proof_php.clauses, {"proof": 1}]
assert_eq of ["proof run still UNSAT", proof_on.status, "UNSAT"]
assert_true of ["proof text recorded", (len of proof_on.proof) > 0]
assert_eq of ["proof line per learnt plus empty clause", len of (split of [proof_on.proof, "\n"]), proof_on.learnts + 2]
assert_eq of ["recording does not change the search", proof_on.resolutions, proof_shape.resolutions]
print of "  DRAT recording: ok"

print of "\n=== All EigenMiniSat solver tests passed ==="
