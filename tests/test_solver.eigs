assert_eq of ["local pressure stats sentinel", stats, "outer-stats"]
assert_eq of ["local pressure asg sentinel", asg, "outer-asg"]
assert_eq of ["local pressure state sentinel", state, "outer-state"]
assert_eq of ["local pressure level sentinel", level, "outer-level"]
assert_eq of ["local pressure analysis sentinel", analysis, "outer-analysis"]
assert_eq of ["local pressure learned sentinel", learned_ci, "outer-learned-ci"]
assert_eq of ["local pressure reduce sentinel", removed_learnts, "outer-removed-learnts"]
assert_eq of ["local pressure decision sentinel", decision_lit, "outer-decision-lit"]
