# ============================================================
# EigenMiniSat CLI
# ============================================================

load_file of "lib/int_vector.eigs"
load_file of "lib/dimacs.eigs"
load_file of "lib/solver.eigs"
load_file of "lib/bench.eigs"

define parse_args() as:
    argv is args of null
    cfg is {"mode": "solve", "path": "", "size": 1, "solver": "scan", "corpus_manifest": "", "proof": "", "show_model": 0, "compact_policy": "", "restart_policy": "", "phase_policy": ""}
    i is 0
    loop while i < (len of argv):
        arg is argv[i]
        if arg == "--bench":
            cfg.mode is "bench"
        elif arg == "--restart-bench":
            cfg.mode is "restart_bench"
        elif arg == "--phase-bench":
            cfg.mode is "phase_bench"
        elif arg == "--heuristic-bench":
            cfg.mode is "heuristic_bench"
        elif arg == "--copy-bench":
            cfg.mode is "copy_bench"
        elif arg == "--storage-bench":
            cfg.mode is "storage_bench"
        elif arg == "--metadata-bench":
            cfg.mode is "metadata_bench"
        elif arg == "--parse-bench":
            cfg.mode is "parse_bench"
        elif arg == "--scan-parse-bench":
            cfg.mode is "scan_parse_bench"
        elif arg == "--diagnostic-bench":
            cfg.mode is "diagnostic_bench"
        elif arg == "--file-bench":
            cfg.mode is "file_bench"
        elif arg == "--corpus-bench":
            cfg.mode is "corpus_bench"
        elif arg == "--random-bench":
            cfg.mode is "random_bench"
        elif arg == "--proof-bench":
            cfg.mode is "proof_bench"
        elif arg == "--proof":
            if i + 1 < (len of argv):
                i += 1
                cfg.proof is argv[i]
        elif arg == "--model":
            cfg.show_model is 1
        elif arg == "--compact-policy":
            if i + 1 < (len of argv):
                i += 1
                cfg.compact_policy is argv[i]
        elif arg == "--restart-policy":
            if i + 1 < (len of argv):
                i += 1
                cfg.restart_policy is argv[i]
        elif arg == "--phase-policy":
            if i + 1 < (len of argv):
                i += 1
                cfg.phase_policy is argv[i]
        elif arg == "--watched":
            cfg.solver is "watched"
        elif arg == "--persistent":
            cfg.solver is "persistent"
        elif arg == "--cdcl":
            cfg.solver is "cdcl"
        elif arg == "--size":
            if i + 1 < (len of argv):
                i += 1
                cfg.size is floor of (num of argv[i])
                if cfg.size < 1:
                    cfg.size is 1
        elif arg == "--manifest":
            if i + 1 < (len of argv):
                i += 1
                cfg.corpus_manifest is argv[i]
        elif arg == "--help" or arg == "-h":
            cfg.mode is "help"
        else:
            cfg.path is arg
        i += 1
    return cfg

define print_help() as:
    print of "Usage:"
    print of "  eigenscript minisat.eigs [--watched|--persistent|--cdcl] <file.cnf>"
    print of "  eigenscript minisat.eigs --bench --size N"
    print of "  eigenscript minisat.eigs --restart-bench --size N"
    print of "  eigenscript minisat.eigs --phase-bench --size N"
    print of "  eigenscript minisat.eigs --heuristic-bench --size N"
    print of "  eigenscript minisat.eigs --copy-bench --size N"
    print of "  eigenscript minisat.eigs --storage-bench --size N"
    print of "  eigenscript minisat.eigs --metadata-bench --size N"
    print of "  eigenscript minisat.eigs --parse-bench --size N"
    print of "  eigenscript minisat.eigs --scan-parse-bench --size N"
    print of "  eigenscript minisat.eigs --diagnostic-bench --size N"
    print of "  eigenscript minisat.eigs --file-bench --size N"
    print of "  eigenscript minisat.eigs --corpus-bench [--manifest PATH]"
    print of "  eigenscript minisat.eigs --random-bench --size N"
    print of "  eigenscript minisat.eigs --proof-bench --size N"
    print of "  eigenscript minisat.eigs --cdcl --proof out.drat <file.cnf>"
    print of "  eigenscript minisat.eigs --cdcl --model <file.cnf>"
    print of "  eigenscript minisat.eigs --cdcl [--compact-policy eager|deferred|lazy]"
    print of "                                 [--restart-policy geometric|luby]"
    print of "                                 [--phase-policy saved|positive|negative|saved_negative] <file.cnf>"
    return null

cfg is parse_args of null

if cfg.mode == "help":
    print_help of null
elif cfg.mode == "bench":
    run_benchmarks of cfg.size
elif cfg.mode == "restart_bench":
    run_restart_benchmarks of cfg.size
elif cfg.mode == "phase_bench":
    run_phase_benchmarks of cfg.size
elif cfg.mode == "heuristic_bench":
    run_heuristic_benchmarks of cfg.size
elif cfg.mode == "copy_bench":
    run_copy_benchmarks of cfg.size
elif cfg.mode == "storage_bench":
    run_storage_benchmarks of cfg.size
elif cfg.mode == "metadata_bench":
    run_metadata_benchmarks of cfg.size
elif cfg.mode == "parse_bench":
    run_parse_benchmarks of cfg.size
elif cfg.mode == "scan_parse_bench":
    run_scan_parse_benchmarks of cfg.size
elif cfg.mode == "diagnostic_bench":
    run_diagnostic_benchmarks of cfg.size
elif cfg.mode == "file_bench":
    run_file_benchmarks of cfg.size
elif cfg.mode == "corpus_bench":
    run_corpus_benchmarks of cfg.corpus_manifest
elif cfg.mode == "random_bench":
    run_random_benchmarks of cfg.size
elif cfg.mode == "proof_bench":
    run_proof_benchmarks of cfg.size
elif cfg.path == "":
    print_help of null
    assert of [0, "missing DIMACS path"]
else:
    parsed is parse_dimacs_file of cfg.path
    assert_dimacs_ok of parsed
    t0 is monotonic_ns of null
    # Dispatch once. This used to run the scan solver unconditionally and then
    # overwrite its result with the selected solver's, so every --watched /
    # --persistent / --cdcl run paid for a full DPLL solve it discarded.
    if cfg.solver == "watched":
        result is solve_cnf_watched of [parsed.nvars, parsed.clauses]
    elif cfg.solver == "persistent":
        result is solve_cnf_persistent of [parsed.nvars, parsed.clauses]
    elif cfg.solver == "cdcl":
        # Build options from the CLI so the reduction/compaction/restart
        # machinery is reachable without writing bench code. Before this, the
        # eager-compaction path could only be driven from lib/bench.eigs, which
        # is why randomized testing never reached it.
        cdcl_opts is {}
        if cfg.proof != "":
            cdcl_opts.proof is 1
        if cfg.compact_policy != "":
            cdcl_opts.compact_policy is cfg.compact_policy
        if cfg.restart_policy != "":
            cdcl_opts.restart_policy is cfg.restart_policy
        if cfg.phase_policy != "":
            cdcl_opts.phase_policy is cfg.phase_policy
        result is solve_cnf_cdcl_with_options of [parsed.nvars, parsed.clauses, cdcl_opts]
    else:
        result is solve_cnf of [parsed.nvars, parsed.clauses]
    t1 is monotonic_ns of null
    ms is (t1 - t0) / 1000000

    if result.status == "SAT":
        print of "s SATISFIABLE"
        # DIMACS v-lines. Without these a SAT answer is not externally
        # checkable -- the mirror of the gap --proof closes for UNSAT. Gated on
        # a flag so existing bench/baseline output is unchanged.
        if cfg.show_model != 0:
            model_line is "v"
            for model_var in range of parsed.nvars:
                model_lit is model_var + 1
                if result.model[model_lit] < 0:
                    model_lit is 0 - model_lit
                model_line is model_line + f" {model_lit}"
            print of (model_line + " 0")
    else:
        print of "s UNSATISFIABLE"
    counters is f"c vars={parsed.nvars} clauses={len of parsed.clauses} decisions={result.decisions} propagations={result.propagations} conflicts={result.conflicts}"
    if cfg.solver == "cdcl":
        # An f-string past ~62 interpolations exceeds the compiler's
        # 128-level expression-depth limit: the lexer desugars one into a `+`
        # chain, about two levels per interpolation. This line was already at
        # that ceiling, so the counters are emitted as two f-strings -- keep
        # them split when adding more. EigenScript #912 (fixed upstream) was
        # the diagnostic, not the limit: it used to fail with no message at
        # all, so today the compiler names the line and the cause. The limit
        # itself is unchanged and this split is still required.
        counters is counters + f" learnts={result.learnts} backjumps={result.backjumps} resolutions={result.resolutions} bumps={result.activity_bumps} decays={result.activity_decays} var_rescales={result.var_rescales} heap_pops={result.order_pops} heap_inserts={result.order_inserts} heap_skips={result.order_skips} clause_allocs={result.clause_allocs} learnt_allocs={result.learnt_allocs} learnt_lits={result.learnt_literals} store_copies={result.store_clause_copies} store_copy_lits={result.store_clause_copy_lits} analysis_rebuilds={result.analysis_rebuilds} analysis_rebuild_lits={result.analysis_rebuild_lits} analysis_store_scans={result.analysis_store_scans} analysis_store_lits={result.analysis_store_lits} analysis_native_learnts={result.analysis_native_learnts} clause_bumps={result.clause_activity_bumps} clause_decays={result.clause_activity_decays} clause_rescales={result.clause_rescales}"
        counters is counters + f" reduce_runs={result.reduce_runs} learnt_limit={result.learnt_limit} reduce_scans={result.reduce_scans} reduce_candidates={result.reduce_candidates} reduce_order_bound={result.reduce_order_bound} lbd_kept_glue={result.lbd_kept_glue} learnt_deleted={result.learnt_deleted} locked_kept={result.learnt_kept_locked} deleted_watch_skips={result.deleted_watch_skips} active_learnts={result.active_learnts} compact_policy={result.compact_policy} compact_checks={result.compact_checks} compact_deferred={result.compact_deferred} pending_deleted={result.compact_pending_deleted} compact_runs={result.compact_runs} compact_removed={result.compact_removed} compact_kept={result.compact_kept} compact_clause_copies={result.compact_clause_copies} compact_clause_lits={result.compact_clause_lits} watch_rebuilds={result.watch_rebuilds} watch_detaches={result.watch_detaches} watch_detach_scans={result.watch_detach_scans} watch_detach_removed={result.watch_detach_removed} watch_prunes={result.watch_prunes} watch_prune_scans={result.watch_prune_scans} watch_prune_removed={result.watch_prune_removed} compact_replays={result.compact_replays} restarts={result.restarts} restart_cancels={result.restart_cancels} restart_budget={result.restart_budget} phase_saves={result.phase_saves} phase_flips={result.phase_flips} phase_pos={result.phase_pos_decisions} phase_neg={result.phase_neg_decisions}"
    print of (counters + f" ms={ms}")

    if cfg.proof != "":
        if cfg.solver != "cdcl":
            print of "c --proof needs --cdcl (only the CDCL path records a refutation); no proof written"
        elif result.status != "UNSAT":
            print of "c satisfiable: no refutation to write (check the model instead)"
        else:
            write_text of [cfg.proof, result.proof]
            print of f"c proof written to {cfg.proof}"
