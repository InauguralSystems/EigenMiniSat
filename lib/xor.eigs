# ============================================================
# Complete CNF XOR recognition (CMS09)
# ============================================================

# Keep recognition deliberately bounded: a k-variable XOR has 2^(k-1)
# clauses, so work and input size are exponential even though grouping is not.
# Eight covers the degree-4 Tseitin corpus with ample room for wider fixtures.
define xor_detection_cap() as:
    return 8

define _xor_pow2(n) as:
    out is 1
    for unused in range of n:
        out is out * 2
    return out

# No general numeric-list ordering helper exists in the repository.  Clauses
# admitted here have at most xor_detection_cap() entries, so the small local
# insertion sort avoids mutating the caller's clause.
define _xor_sorted_clause(clause) as:
    out is []
    for lit in clause:
        append of [out, lit]
        pos is (len of out) - 1
        v is lit
        if v < 0:
            v is 0 - v
        loop while pos > 0:
            prev is out[pos - 1]
            prev_v is prev
            if prev_v < 0:
                prev_v is 0 - prev_v
            if prev_v <= v:
                break
            out[pos] is out[pos - 1]
            pos -= 1
        out[pos] is lit
    return out

define _xor_clause_shape(clause, cap) as:
    k is len of clause
    if k < 1 or k > cap:
        return {"ok": 0}
    ordered is _xor_sorted_clause of clause
    vars is []
    pattern is 0
    negatives is 0
    bit is 1
    previous is -1
    for lit in ordered:
        v is lit
        if v < 0:
            v is 0 - v
            pattern += bit
            negatives += 1
        if v == 0 or v == previous:
            # Repeated variables (including tautologies) cannot be members of
            # the canonical 2^(k-1)-clause encoding.
            return {"ok": 0}
        append of [vars, v]
        previous is v
        bit is bit * 2
    return {"ok": 1, "vars": vars, "pattern": pattern, "parity": negatives % 2}

define _xor_same_vars(a, b) as:
    if (len of a) != (len of b):
        return 0
    i is 0
    loop while i < (len of a):
        if a[i] != b[i]:
            return 0
        i += 1
    return 1

define _xor_find_group(groups, vars) as:
    i is 0
    loop while i < (len of groups):
        if (_xor_same_vars of [groups[i].vars, vars]) != 0:
            return i
        i += 1
    return -1

define _xor_pattern_seen(patterns, pattern) as:
    for seen in patterns:
        if seen == pattern:
            return 1
    return 0

# CMS09 recognition criterion: group clauses by identical variable set, then
# accept a parity only when every one of its 2^(k-1) falsifying assignments is
# present.  Duplicate clauses are retained in coverage but do not fill a
# missing assignment. Literal order is erased by _xor_clause_shape.
define detect_xors(clauses) as:
    cap is xor_detection_cap of null
    groups is []
    clause_index is 0
    for clause in clauses:
        shape is _xor_clause_shape of [clause, cap]
        if shape.ok != 0:
            gi is _xor_find_group of [groups, shape.vars]
            if gi < 0:
                append of [groups, {"vars": shape.vars, "even": [], "odd": [], "even_clauses": [], "odd_clauses": []}]
                gi is (len of groups) - 1
            if shape.parity == 0:
                if (_xor_pattern_seen of [groups[gi].even, shape.pattern]) == 0:
                    append of [groups[gi].even, shape.pattern]
                append of [groups[gi].even_clauses, clause_index]
            else:
                if (_xor_pattern_seen of [groups[gi].odd, shape.pattern]) == 0:
                    append of [groups[gi].odd, shape.pattern]
                append of [groups[gi].odd_clauses, clause_index]
        clause_index += 1

    xors is []
    covered_flags is []
    for unused in clauses:
        append of [covered_flags, 0]
    for group in groups:
        need is _xor_pow2 of ((len of group.vars) - 1)
        # Clauses falsifying even assignments encode XOR=1; clauses falsifying
        # odd assignments encode XOR=0.
        if (len of group.even) == need:
            append of [xors, {"vars": group.vars, "rhs": 1, "clause_count": len of group.even_clauses}]
            for ci in group.even_clauses:
                covered_flags[ci] is 1
        if (len of group.odd) == need:
            append of [xors, {"vars": group.vars, "rhs": 0, "clause_count": len of group.odd_clauses}]
            for ci in group.odd_clauses:
                covered_flags[ci] is 1

    covered is 0
    for flag in covered_flags:
        covered += flag
    fraction is 0
    if (len of clauses) > 0:
        fraction is covered / (len of clauses)
    return {"xors": xors, "xor_count": len of xors, "covered_clauses": covered, "total_clauses": len of clauses, "coverage": fraction, "cap": cap}
